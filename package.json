{
  "name": "trace",
  "private": true,
  "version": "0.1.0",
  "description": "Alex — BNPL agent. Memory-grounded Approve / reduced limit / Decline installment terms.",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "test": "npx tsx --test lib/**/*.test.ts sibyl/bridge.test.ts",
    "mcp": "npx tsx mcp/server.ts",
    "sibyl:health": ".venv/bin/python sibyl/bridge.py <<< '{\"op\":\"health\"}'",
    "wallet:create": "npx tsx scripts/create-wallet.ts",
    "memory:seed": "npx tsx scripts/seed-memory.ts",
    "memory:reset": "npx tsx scripts/reset-memory-empty.ts",
    "memory:export": "npx tsx scripts/export-memory.ts"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "gsap": "^3.15.0",
    "next": "^15.4.6",
    "openai": "^5.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}

# SpaceXAI / xAI — optional. Alex still decides without it.
XAI_API_KEY=

# Sibyl Memory (required)
SIBYL_PYTHON=.venv/bin/python
SIBYL_MEMORY_DB=.data/sibyl-memory.db
SIBYL_TENANT=trace-alex

# Treasury signer. No wallet connect.
# This key broadcasts after Proceed / Proceed with flag, and after you approve a Hold.
# Fund it with ETH for gas, plus the token you will send.
BASE_PRIVATE_KEY=
# 84532 = Base Sepolia (testnet). 8453 = Base mainnet.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# Must be 1 or the agent only records the decision in Sibyl.
BASE_EXECUTE=1

# SpaceXAI / xAI — optional. Alex still decides without it.
XAI_API_KEY=

# Sibyl Memory. Local: Python venv + SQLite. Vercel has no Python, so Node storage is used.
SIBYL_PYTHON=.venv/bin/python
SIBYL_MEMORY_DB=.data/sibyl-memory.db
SIBYL_TENANT=trace-alex
# Vercel Redis (Storage → Create → Redis / Upstash). Injected automatically on deploy.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Treasury signer. Generated by `pnpm wallet:create`. Never commit.
# On Vercel, set AGENT_PRIVATE_KEY and BASE_EXECUTE=1 for live payouts.
# Stats still read the published address in config/agent-wallet.json without the key.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=0x6F75c81375B43AcE7cE839D6eAc7192e10a4440e
BASE_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://sepolia.base.org
# 84532 = Base Sepolia. 8453 = Base mainnet.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# Must be 1 or the agent only records the decision in Sibyl.
BASE_EXECUTE=1
# Virtuals ACP jobs use the same broadcast gate. Set VIRTUALS_ACP=0 to skip ACP
# without faking a job. Default: ACP runs when BASE_EXECUTE=1.
# VIRTUALS_ACP=1
# Hard cap in USDC-equivalent. Blocks execution before risk scoring.
MAX_TX_AMOUNT_USDC=25
# Lending ceilings (legacy desk).
MAX_BORROW_AMOUNT=50
MIN_COLLATERAL_RATIO=1.5
# BNPL ceilings. Checked before terms calculation. Not overridable by the LLM.
# $10k is the unlocked cap at standing 0.95 (score 95). Score 50 is $3k; below 50 is lower.
MAX_PURCHASE_AMOUNT=10000
MAX_ACTIVE_PLANS=2
# Optional merchant the agent pays on Base Sepolia when BASE_EXECUTE=1.
MOCK_MERCHANT=0x00000000000000000000000000000000000000b1
# Agent cannot approve a payout that would leave spendable cash below this (USDC-equivalent).
MIN_AGENT_RESERVE=5
# Display amounts are USDC. Merchant payout and user repay settle in ETH at this USD price.
ETH_USD=2000
# Used only when AGENT_PRIVATE_KEY is missing or the chain balance cannot be read.
AGENT_SIMULATED_USDC=100

# SpaceXAI / xAI — used by Alex to write memory-grounded reasoning.
# The decision itself is computed in code from RISK_SCORE.
XAI_API_KEY=

# Sibyl Memory (required, load-bearing)
SIBYL_PYTHON=.venv/bin/python
SIBYL_MEMORY_DB=.data/sibyl-memory.db
SIBYL_TENANT=trace-alex

# Optional Base Sepolia attestation of the memory hash
BASE_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
